#!/bin/bash
for usb in `cat /proc/acpi/wakeup | cut -f1`;
do
	state=`cat /proc/acpi/wakeup | grep $usb | cut -f3 | cut -d' ' -f1 | tr -d '*'`
	echo "device = $usb, state = $state"
	if [ "$state" == "enabled" ]
	then
		sudo su -c 'echo $usb > /proc/acpi/wakeup'
		echo 'echo $usb > /proc/acpi/wakeup'
	fi
done


