# ─────────────────────────────────────────────────────────────────────────────
# ~/.zshrc.local — machine-specific zsh, sourced last by tty/zshrc
#
# Copy this to ~/.zshrc.local on a machine and it takes over for everything that
# belongs to that machine alone. tty/zshrc stays clean and update-safe; this file
# is not tracked by git, so edits here never conflict with a self-update and
# never get pushed onto a different machine.
#
# It is sourced after oh-my-zsh, so you can override theme and plugins here, and
# it can assume $HOME/bin is already on PATH.
#
# The example below is the framework-13 laptop: nvm, deno, the Android SDK, and
# the old alias file.
# ─────────────────────────────────────────────────────────────────────────────

# Theme / plugins for this machine only (tty/zshrc loads robbyrussell + git).
# ZSH_THEME="gallois"
# source "$ZSH/oh-my-zsh.sh"   # re-source if you change plugins after the fact

# ── node via nvm (Arch ships the init script; other hosts use ~/.nvm) ────────
if [[ -f /usr/share/nvm/init-nvm.sh ]]; then
	source /usr/share/nvm/init-nvm.sh
elif [[ -f "$HOME/.nvm/nvm.sh" ]]; then
	export NVM_DIR="$HOME/.nvm"
	# shellcheck disable=SC1091
	source "$NVM_DIR/nvm.sh"
fi

# ── deno ────────────────────────────────────────────────────────────────────
[[ -f "$HOME/.deno/env" ]] && source "$HOME/.deno/env"

# ── Android SDK + JetBrains Toolbox ──────────────────────────────────────────
if [[ -d /opt/android-sdk ]]; then
	export ANDROID_HOME=/opt/android-sdk
	export PATH="$PATH:$ANDROID_HOME/emulator:$ANDROID_HOME/tools:$ANDROID_HOME/tools/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/cmdline-tools/latest/bin"
fi
[[ -d "$HOME/.local/share/JetBrains/Toolbox/scripts" ]] &&
	export PATH="$PATH:$HOME/.local/share/JetBrains/Toolbox/scripts"

# ── pi voice capture (Termux) — nothing to set here ───────────────────────
# pi-voice-stt captures with ffmpeg. On a normal host that already works: leave
# PI_STT_CONFIG unset and the extension picks its own platform default (pulse on
# Linux, avfoundation on macOS, dshow on Windows).
#
# Termux is the exception. Its ffmpeg is built --disable-indevs
# --enable-indev=lavfi, so it has no live audio input whatsoever, does not link
# libpulse, and /dev/snd is sandbox-blocked. "Unknown input format: 'pulse'" is
# that, not a bad device name. $HOME/bin/termux-capture accepts the same argv and
# records via termux-microphone-record instead.
#
# The capture block belongs INLINE in ~/.pi/agent/stt.json, NOT in a sidecar
# behind PI_STT_CONFIG, for two reasons:
#
#   1. PI_STT_CONFIG is read once at process start. /reload cannot pick it up, and
#      pi must be relaunched from a shell that already sourced this file — so it
#      breaks whenever pi starts from an older shell.
#   2. It REPLACES the config path rather than merging over it. A capture-only
#      sidecar therefore loses provider + cleanup and silently falls back to the
#      built-in Mistral/Voxtral default, which fails confusingly with no key set.
#
# So do not export PI_STT_CONFIG here. Verify resolution with:
#
#   pi-stt-where        # prints the config file + ffmpegPath pi actually resolved
#
# Independent of all config: Android denies the microphone while Termux is in the
# background (SSH and tmux included), yielding pure digital silence. Only fixing
# it is keeping the Termux window on screen. There is no way to detect this from
# inside Termux — dumpsys is sandbox-blocked.

# ── per-machine aliases ─────────────────────────────────────────────────

# ── per-machine aliases ─────────────────────────────────────────────────────
[[ -f "$HOME/.zsh_aliases" ]] && source "$HOME/.zsh_aliases"

# ── knob examples for the shared config ──────────────────────────────────────
# DOTFILES_TMUX_AUTOATTACH=0    # no tmux on login to this host
# DOTFILES_UPDATE_DISABLE=1     # never touch this checkout
# DOTFILES_UPDATE_MODE=notify   # fetch and report, but do not fast-forward
# DOTFILES_UPDATE_DAYS=30
