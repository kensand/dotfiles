# Ignore everything by default, then whitelist what we want tracked
*

# Dotfiles
!.gitignore
!.gitconfig
!.gitmodules
!LICENSE
!README.md
!.zshrc
!.zsh_aliases
!.bashrc
!.tmux.conf
!.vimrc
!.Xdefaults
!.Xresources

# Shell config
!.config/
!.config/oh-my-zsh

# Headless / TTY bundle: the zsh + tmux configs bin/setup-tty.sh installs on
# SSH-only hosts. The desktop's ~/.zshrc is a one-line shim onto tty/zshrc, so
# this directory is shared by both layouts.
!tty/
!tty/**

# Machine-specific shell overrides, deliberately NOT tracked: toolchain paths
# differ per host. tty/zshrc.local.example is the documented template.
.zshrc.local

# Sway / Wayland
!.config/sway
!.config/sway/**
!.config/waybar
!.config/waybar/**
!.config/fuzzel
!.config/fuzzel/**
!.config/way-displays
!.config/way-displays/**

# Systemd user services
!.config/systemd/user/
!.config/systemd/user/**

# Wallpaper script (submodule)
!.config/Daily-Reddit-Wallpaper

# fcli config lives at ~/.f/f.config.json, not ~/.config/f — f reads it from
# there. No secrets: the encrypted store is the untracked ~/.f/f.creds.enc, and
# the `*` rule above keeps every other entry in ~/.f ignored.
!.f/
!.f/f.config.json

# Konsole profile
!.local/share/konsole/
!.local/share/konsole/**

# Pi coding agent (only settings.json is tracked; .pi/agent/.gitignore
# blocks auth.json, mcp.json, models.json, sessions/, caches, etc.)
!.pi/
!.pi/agent/
!.pi/agent/.gitignore
!.pi/agent/settings.json

# Vim
!.vim/
!.vim/*
!.vim/*/*
!.vim/**
.vim/plugged/*

# Scripts
!bin/
!bin/*
!bin/*/*
bin/jetbrains-toolbox
.vim/.netrwhist
