# Ignore everything by default, then whitelist what we want tracked
*

# Dotfiles
!.gitignore
!.gitconfig
!.gitmodules
!LICENSE
!README.md
!.zshrc
!.zsh_aliases
!.bashrc
!.tmux.conf
!.vimrc
!.Xdefaults
!.Xresources

# Shell config
!.config/
!.config/oh-my-zsh

# Sway / Wayland
!.config/sway
!.config/sway/**
!.config/waybar
!.config/waybar/**
!.config/fuzzel
!.config/fuzzel/**
!.config/way-displays
!.config/way-displays/**

# Systemd user services
!.config/systemd/user/
!.config/systemd/user/**

# Wallpaper script (submodule)
!.config/Daily-Reddit-Wallpaper

# Konsole profile
!.local/share/konsole/
!.local/share/konsole/**

# Pi coding agent (only settings.json is tracked; .pi/agent/.gitignore
# blocks auth.json, mcp.json, models.json, sessions/, caches, etc.)
!.pi/
!.pi/agent/
!.pi/agent/.gitignore
!.pi/agent/settings.json

# Vim
!.vim/
!.vim/*
!.vim/*/*
!.vim/**
.vim/plugged/*

# Scripts
!bin/
!bin/*
!bin/*/*
bin/jetbrains-toolbox
.vim/.netrwhist
